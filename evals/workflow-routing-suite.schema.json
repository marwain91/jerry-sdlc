{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 35,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "request", "files", "workflow"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "minLength": 1},
          "files": {"type": "string"},
          "workflow": {"enum": ["release-readiness", "feature", "bug-fix", "bug-diagnosis", "pr-review", "trivial-change", "incident"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
