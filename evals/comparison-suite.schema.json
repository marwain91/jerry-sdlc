{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exploratory three-arm adjudicated comparison",
  "type": "object",
  "required": [
    "schemaVersion",
    "provenance",
    "trialsPerArm",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "provenance": {
      "enum": [
        "SYNTHETIC",
        "ADJUDICATED"
      ]
    },
    "trialsPerArm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "candidate",
          "conditionsDigest",
          "knownFindings",
          "arms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "conditionsDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "knownFindings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "severity"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "enum": [
                    "CRITICAL",
                    "HIGH",
                    "MEDIUM",
                    "LOW"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "arms": {
            "type": "object",
            "required": [
              "baseline",
              "lightweight",
              "full"
            ],
            "properties": {
              "baseline": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/run"
                }
              },
              "lightweight": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/run"
                }
              },
              "full": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/run"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "trial",
        "conditionsDigest",
        "evidence",
        "findings",
        "usage",
        "tokenCoverage",
        "activeMilliseconds",
        "waitMilliseconds",
        "humanMilliseconds",
        "escapedDefects",
        "reopenedTasks",
        "unauthorizedActions",
        "falseIndependenceClaims",
        "readyWithKnownBlocker",
        "evidenceFabrications",
        "correctionRegressions"
      ],
      "properties": {
        "trial": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "conditionsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "id",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "TRUE_POSITIVE",
                  "FALSE_POSITIVE"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "usage": {
          "type": "object",
          "required": [
            "inputTokens",
            "cachedInputTokens",
            "outputTokens"
          ],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "additionalProperties": false
        },
        "tokenCoverage": {
          "const": "ALL_WORKERS"
        },
        "activeMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800000
        },
        "waitMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "humanMilliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "escapedDefects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "reopenedTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unauthorizedActions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "falseIndependenceClaims": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "readyWithKnownBlocker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "evidenceFabrications": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "correctionRegressions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    }
  }
}
