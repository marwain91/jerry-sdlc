{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC adapter protocol record",
  "type": "object",
  "required": ["schemaVersion", "protocolVersion", "adapterName", "runId", "candidateLabel", "workflow", "workflowVersion", "role", "assignmentId", "assignmentDigest", "repositoryDigest", "policyDigest", "roleContractDigest", "contractSetDigest", "schemaDigest", "workerInstanceId", "resultDigest", "replayId", "mode", "capabilities", "trust", "recordedAt"],
  "properties": {
    "schemaVersion": {"const": 2},
    "protocolVersion": {"const": 2},
    "adapterName": {"type": "string", "minLength": 1, "maxLength": 128},
    "runId": {"type": "string", "minLength": 1, "maxLength": 256},
    "candidateLabel": {"type": "string", "minLength": 1, "maxLength": 256},
    "workflow": {"const": "release-readiness"},
    "workflowVersion": {"const": 1},
    "role": {"enum": ["qa-architect", "qa-executor", "specialist-reviewer", "independent-verifier"]},
    "assignmentId": {"enum": ["qa-architecture", "qa-execution", "specialist-security", "specialist-supply-chain", "specialist-api-compatibility", "specialist-data-migration", "specialist-reliability", "specialist-observability", "specialist-documentation", "independent-verification"]},
    "assignmentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repositoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "roleContractDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contractSetDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schemaDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workerInstanceId": {"type": "string", "minLength": 1, "maxLength": 256},
    "resultDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replayId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"const": "READ_ONLY"},
    "capabilities": {"$ref": "adapter-catalog.schema.json#/$defs/adapter/properties/capabilities"},
    "trust": {"const": "OBSERVED_UNATTESTED"},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
