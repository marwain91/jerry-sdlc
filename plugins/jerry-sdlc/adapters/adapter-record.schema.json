{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC adapter protocol record",
  "type": "object",
  "required": ["schemaVersion", "protocolVersion", "adapterName", "runId", "candidateLabel", "role", "repositoryDigest", "policyDigest", "roleContractDigest", "workerInstanceId", "resultDigest", "mode", "capabilities", "trust", "recordedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": 1},
    "adapterName": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "candidateLabel": {"type": "string", "minLength": 1},
    "role": {"enum": ["qa-architect", "qa-executor", "specialist-reviewer", "independent-verifier"]},
    "repositoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "roleContractDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workerInstanceId": {"type": "string", "minLength": 1},
    "resultDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"const": "READ_ONLY"},
    "capabilities": {"$ref": "adapter-catalog.schema.json#/$defs/adapter/properties/capabilities"},
    "trust": {"const": "OBSERVED_UNATTESTED"},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
