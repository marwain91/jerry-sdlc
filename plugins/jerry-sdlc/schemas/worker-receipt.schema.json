{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC read-only worker receipt",
  "type": "object",
  "required": ["schemaVersion", "runId", "repository", "candidateLabel", "repositoryDigest", "role", "roleContractDigest", "workflowDigest", "schemaDigest", "threadId", "sandboxModeRequested", "codexVersion", "promptDigest", "outputDigest", "startedAt", "completedAt", "command", "exitStatus"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "candidateLabel": {"type": "string", "minLength": 1},
    "repositoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {"enum": ["qa-architect", "qa-executor", "specialist-reviewer", "independent-verifier"]},
    "roleContractDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workflowDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schemaDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "threadId": {"type": "string", "minLength": 1},
    "sandboxModeRequested": {"const": "read-only"},
    "codexVersion": {"type": "string", "minLength": 1},
    "promptDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outputDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exitStatus": {"const": 0}
  },
  "additionalProperties": false
}
