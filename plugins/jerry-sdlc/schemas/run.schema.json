{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC run",
  "type": "object",
  "required": ["schemaVersion", "id", "workflow", "state", "assurance", "repository", "candidate", "contentDigest", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "workflow": {"type": "string", "minLength": 1},
    "state": {"enum": ["BASELINED", "STRATEGY_READY", "EVIDENCE_COLLECTED", "REVIEWED", "ADJUDICATED", "VERIFIED", "NOT_READY", "INCONCLUSIVE", "CANCELLED", "BLOCKED"]},
    "assurance": {"enum": ["MANAGED_SEPARATE_PASSES", "ADVISORY_ONLY"]},
    "repository": {"type": "string", "minLength": 1},
    "candidate": {"type": "string", "minLength": 1},
    "contentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
