{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC adjudication evidence",
  "type": "object",
  "required": ["schemaVersion", "runId", "repository", "candidateLabel", "repositoryDigest", "teamEvidenceDigest", "trust", "decisions", "recordedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "candidateLabel": {"type": "string", "minLength": 1},
    "repositoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "teamEvidenceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trust": {"const": "LOCAL_USER_AUTHORIZED"},
    "decisions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "adjudication-input.schema.json#/$defs/decision"}},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
