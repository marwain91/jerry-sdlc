{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC correction authorization",
  "type": "object",
  "required": ["schemaVersion", "runId", "repository", "candidateLabel", "repositoryDigest", "teamEvidenceDigest", "findingIds", "allowedPaths", "baselineManifest", "correctionCycle", "trust", "authorizedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "candidateLabel": {"type": "string", "minLength": 1},
    "repositoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "teamEvidenceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "findingIds": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowedPaths": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "baselineManifest": {"type": "array", "maxItems": 100000, "items": {"type": "object", "required": ["path", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "mode": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "correctionCycle": {"type": "integer", "minimum": 1, "maximum": 2},
    "trust": {"const": "LOCAL_USER_AUTHORIZED"},
    "authorizedAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
