{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC worker result",
  "type": "object",
  "required": ["disposition", "evidence", "findings", "limitations", "domains"],
  "properties": {
    "disposition": {"enum": ["CLEAN", "FINDINGS", "INCONCLUSIVE", "BLOCKED"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "confidence", "requirement", "location", "evidence", "recommendation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
          "requirement": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "status", "evidence", "evidenceIds"],
        "properties": {
          "domain": {"enum": ["functional", "security", "supply-chain", "api-compatibility", "data-migration", "reliability", "observability", "documentation", "candidate-identity"]},
          "status": {"enum": ["PASS", "NOT_APPLICABLE", "BLOCKED"]},
          "evidence": {"type": "string", "minLength": 1},
          "evidenceIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_-]{1,80}$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
