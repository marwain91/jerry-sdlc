{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Everyday check dependencies and reuse provenance",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "checkId",
    "inputs",
    "inputDigest",
    "environment",
    "commandDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,80}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRun": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "sourceCheck": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,80}$"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "sourceRun": [
      "sourceCheck",
      "sourceDigest"
    ],
    "sourceCheck": [
      "sourceRun",
      "sourceDigest"
    ],
    "sourceDigest": [
      "sourceRun",
      "sourceCheck"
    ]
  }
}
