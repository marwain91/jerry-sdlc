{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jerry SDLC adjudication input",
  "type": "object",
  "required": ["schemaVersion", "teamEvidenceDigest", "decisions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "teamEvidenceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["kind", "id", "disposition", "rationale", "evidenceIds"],
      "properties": {
        "kind": {"enum": ["FINDING", "DOMAIN_NOT_APPLICABLE"]},
        "id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["ACCEPTED", "REJECTED"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]{1,80}$"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
